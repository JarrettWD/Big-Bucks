# The only two values the app ever holds. Both are public by design (row-level
# security protects the data). `npm run demo` and `npm run setup-account` write
# .env.local with the LOCAL values for you; this file just documents the names.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-here
